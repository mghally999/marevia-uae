# Canonical site URL — used for metadata, OG tags, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://mareviauae.com

# Optional. ISO 8601 date. When set, a countdown appears on the page.
# Leave unset to hide the countdown entirely.
# NEXT_PUBLIC_LAUNCH_DATE=2026-10-01T09:00:00+04:00

# Optional. Any endpoint that accepts a JSON POST — Zapier, Make, Airtable,
# a Slack incoming webhook, your own CRM. Each signup is forwarded as
# { email, source, submittedAt }. Without it, signups are logged to the
# server console instead.
# NOTIFY_WEBHOOK_URL=
